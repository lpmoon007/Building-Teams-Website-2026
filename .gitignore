# Build output IS committed (dist/) so the server deploy is a pure file copy —
# no Node/build step on the host to fail. Regenerate with `node build.js` and
# commit the result; never hand-edit files under dist/.

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Node (only if you add tooling later)
node_modules/
npm-debug.log*

# Internal working docs — keep local, don't deploy
Strategy Brief.html
Deployment Guide.html
Launch & Growth Plan.html
Lost-Link Outreach Templates.html
Spam Cleanup Checklist.html
Directions.html

# Print/PDF plumbing — generated for PDF export, not a deployable page
State of Team Building 2026-print.html

# Source materials handed over for reference
uploads/
package-lock.json
